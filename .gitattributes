Assets/qoooo/Models/**/*.png filter=lfs diff=lfs merge=lfs -text
Assets/qoooo/Models/**/*.jpg filter=lfs diff=lfs merge=lfs -text
Assets/qoooo/Models/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
Assets/qoooo/Models/**/*.tga filter=lfs diff=lfs merge=lfs -text
Assets/qoooo/Models/**/*.tif filter=lfs diff=lfs merge=lfs -text
Assets/qoooo/Models/**/*.tiff filter=lfs diff=lfs merge=lfs -text
Assets/qoooo/Models/**/*.exr filter=lfs diff=lfs merge=lfs -text
Assets/qoooo/Models/**/*.hdr filter=lfs diff=lfs merge=lfs -text
